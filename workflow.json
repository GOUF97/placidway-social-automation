{
  "name": "PlacidWay Social Media Content Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://www.placidway.com/sitemap.xml",
        "options": {}
      },
      "name": "Extract PlacidWay Sitemap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "URL": "={{ $json.url }}"
          }
        },
        "options": {}
      },
      "name": "Deduplication & State Store",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [690, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Analyze the following PlacidWay medical tourism page content and generate a concise, engaging Facebook post under 500 characters. STRICT GUARDRAILS: Do not fabricate prices, do not make absolute medical claims, and do not promise treatment outcomes. Always keep it factual and include the source link.",
        "options": {
          "systemMessage": "You are a professional social media manager for PlacidWay. You enforce strict compliance with medical information guardrails."
        }
      },
      "name": "AI Generate Post & Guardrails",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [910, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "approval_check",
              "leftValue": "={{ $json.output }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Approval Check IF",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/me/feed",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.output }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Publish to Facebook via API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1350, 220]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Extract PlacidWay Sitemap",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract PlacidWay Sitemap": {
      "main": [
        [
          {
            "node": "Deduplication & State Store",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deduplication & State Store": {
      "main": [
        [
          {
            "node": "AI Generate Post & Guardrails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Generate Post & Guardrails": {
      "main": [
        [
          {
            "node": "Approval Check IF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approval Check IF": {
      "main": [
        [
          {
            "node": "Publish to Facebook via API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
